{
  "name": "conxian-labs-site",
  "version": "1.1.0",
  "license": "MIT",
  "description": "Official website for Conxian Labs",
  "scripts": {
    "start": "node server.js",
    "test": "playwright test",
    "build:css": "tailwindcss -i css/tailwind.src.css -o css/tailwind.css --minify",
    "test:api": "node --test tests/managed-onboarding.test.cjs tests/discovery.test.cjs tests/status-truth.test.cjs tests/icon-map.test.cjs tests/search-index.test.cjs tests/page-css-hygiene.test.cjs tests/managed-tier-gate.test.cjs tests/rate-limit.test.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "@playwright/browser-chromium": "^1.65.0",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "body-parser": "2.4.0",
    "source-map-js": "1.2.2"
  },
  "engines": {
    "node": ">=26 <27"
  }
}
