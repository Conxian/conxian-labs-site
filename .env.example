# Conxian Labs Site - Environment Configuration Template
# DO NOT COMMIT ACTUAL SECRETS TO SOURCE CONTROL

# Server Configuration
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Managed tier activation (both are required; either one alone leaves the tier
# unavailable and returns HTTP 503 subscription_unavailable).
#
# The managed tier is derived from these two values at request time. Set BOTH
# and the tier moves from "reference-only" to "live"; unset either and it stays
# a design reference rather than accepting payment.
#
#   MERCHANT_CHECKOUT_URL   Hosted Merchant-of-Record checkout target. Its
#                           absence means there is no payment path.
#   MANAGED_GATEWAY_ENDPOINT Delivery endpoint that mints entitlement and
#                           issues keys after settlement. Its absence means a
#                           purchase could be taken without anything delivered.
#
# Only set these once the provider contract, payment, entitlement, and runtime
# evidence exist. See /research#managed-tier-enablement for the full chain.
# ---------------------------------------------------------------------------
# MERCHANT_CHECKOUT_URL=
# MANAGED_GATEWAY_ENDPOINT=

# Gated access-request intake. When unset, POST /api/onboarding/request-access
# fails closed with a mailto fallback instead of implying a request was stored.
# ACCESS_REQUEST_ENDPOINT=

