# Conxian Labs Site - Environment Configuration Template
# DO NOT COMMIT ACTUAL SECRETS TO SOURCE CONTROL

# Server Configuration
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Managed tier activation (both valid public HTTPS URLs are required; either one alone leaves the tier
# unavailable and returns HTTP 503 subscription_unavailable).
#
# Per ADR-009 the gateway is the single monetization surface and the Lightning
# subscription rail is the sanctioned crypto-native checkout (no card-network
# Merchant of Record: their acceptable-use policies forbid this product). The
# site relays a Lightning invoice from the gateway; it never handles the payment.
# Both must be valid public HTTPS URLs (no credentials or placeholder hosts);
# invalid or unset values keep the tier a design reference.
#
#   MANAGED_BILLING_BASE_URL  Gateway billing base, e.g. https://api.conxian-labs.com.
#                             Its absence means no payment rail. This is the gate:
#                             the base host is also the delivery endpoint.
#   MANAGED_GATEWAY_ENDPOINT  Optional override for the delivery endpoint when the
#                             delivery host differs from the billing base. Unset =
#                             the billing base is used.
#
# Only set these once the provider, payment, entitlement, and runtime evidence
# exist. See /research#managed-tier-enablement for the full chain.
# ---------------------------------------------------------------------------
# MANAGED_BILLING_BASE_URL=
# MANAGED_GATEWAY_ENDPOINT=

# Gated access-request intake. When unset, POST /api/onboarding/request-access
# fails closed with a mailto fallback instead of implying a request was stored.
# ACCESS_REQUEST_ENDPOINT=

